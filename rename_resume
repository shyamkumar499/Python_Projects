job_title_keywords = [
    "software engineer", "developer", "data analyst", "project manager",
    "data scientist", "consultant", "intern", "tester", "qa engineer", "business analyst"
]

def extract_job_titles(text):
    matches = []
    for title in job_title_keywords:
        if re.search(rf"\b{title}\b", text, re.IGNORECASE):
            matches.append(title.title())
    return "; ".join(set(matches)) if matches else ""
