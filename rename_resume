common_skills = [
    "Python", "Java", "C++", "SQL", "Excel", "JavaScript", "HTML", "CSS", 
    "Pandas", "NumPy", "TensorFlow", "React", "Node.js", "Git", "AWS", "Azure", "Docker"
]

def extract_skills(text):
    skills_found = [skill for skill in common_skills if re.search(rf"\b{skill}\b", text, re.IGNORECASE)]
    return "; ".join(set(skills_found)) if skills_found else ""
